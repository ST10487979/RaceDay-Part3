<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons (Optional but looks great for sporting themes) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        
        .navbar-raceday {
            background: linear-gradient(135deg, #1A237E 0%, #283593 100%); 
        }

        .btn-cta {
            background-color: #FFC107; 
            color: #1A237E;
            font-weight: 600;
        }

            .btn-cta:hover {
                background-color: #FFCA2C;
                color: #000;
            }
        
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark navbar-raceday shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-warning" asp-controller="Home" asp-action="Index">
                <i class="bi bi-trophy-fill"></i> RaceDay
            </a>

            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    @{
                        var role = Context.Session.GetString("Role");
                        var name = Context.Session.GetString("FullName");
                    }

                    @if (string.IsNullOrEmpty(role))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Browse Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li class="nav-item ms-lg-2"><a class="btn btn-cta px-3" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                    else if (role == "Organiser")
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="ManageEvents"><i class="bi bi-calendar-event"></i> My Events</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index"><i class="bi bi-search"></i> Find Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents"><i class="bi bi-bookmark-check"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-stopwatch"></i> My Results</a></li>
                    }

                    @if (!string.IsNullOrEmpty(role))
                    {
                        
                        <li class="nav-item ms-lg-3">
                            <span class="nav-link text-warning fw-bold"><i class="bi bi-person-circle"></i> @name</span>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm mt-1">Logout</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="container py-4">
        <!-- Alerts for Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm">
                <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; 2026 RaceDay Application. Built for the South African running, walking & cycling community.</small>
        </div>
    </footer>

    <!-- Bootstrap JS (Required for mobile menu toggle) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts Section for individual pages to inject their own JS -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>