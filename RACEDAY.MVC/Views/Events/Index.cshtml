@model List<RaceDay.MVC.Models.EventDto>
<h2>Upcoming Events</h2>
<div class="row">
    @foreach (var evt in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                @if (!string.IsNullOrEmpty(evt.BannerImageUrl))
                {
                    <img src="@evt.BannerImageUrl" class="card-img-top" style="height:180px; object-fit:cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@evt.Title</h5>
                    <p class="text-muted mb-1">@evt.EventDate.ToString("dd MMM yyyy") - @evt.Location</p>
                    <a asp-action="Details" asp-route-id="@evt.EventID" class="btn btn-outline-primary w-100 mt-2">View Details</a>
                </div>
            </div>
        </div>
    }
</div>